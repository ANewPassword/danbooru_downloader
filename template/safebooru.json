{
	"mode": {
		"page": {
			"api": "https://safebooru.org/index.php?page=dapi&s=post&q=index&json=1&limit=1000&tags=${tags}&pid=!{real_page_id}",
			"download": {
				"metadata": "!{all_metadata_format}",
				"filename": "#{id}.!{file_ext_format}",
				"header": {
					"Referer": "https://safebooru.org/"
				}
			}
		},
		"id": {
			"api": "https://safebooru.org/index.php?page=dapi&s=post&q=index&json=1&limit=1000&tags=${tags}&pid=!{real_page_id}",
			"download": {
				"metadata": "!{all_metadata_format}",
				"filename": "#{id}.!{file_ext_format}",
				"header": {
					"Referer": "https://safebooru.org/"
				}
			}
		}
	},
	"advanced": {
		"positioner": {
			"#root": "",
			"#id": "[${index}]['id']",
			"#md5": "[${index}]['hash']",
			"#file_url": "[${index}]['file_url']",
			"#all_metadata": "[${index}]",
			"#file_ext": "[${index}]['file_url']"
		},
		"variable": {
			"!real_page_id": "exec_result = int(${page}) - 1",
			"!all_metadata_format": "from func.json import json_encode\nexec_result = json_encode(#{all_metadata})",
			"!file_ext_format": "exec_result = #{file_ext}.split('.')[-1]"
		}
	}
}